{
  "_comment": "EXAMPLE ONLY - AWS-style security group for a single web server. IDs are placeholders and 203.0.113.10/32 (documentation range) stands for 'my public IP'. Replace before use.",
  "GroupName": "codomax-web-sg",
  "Description": "Web server: SSH from admin IP only, HTTP/HTTPS from anywhere",
  "VpcId": "vpc-0123456789abcdef0",
  "IpPermissions": [
    {
      "IpProtocol": "tcp",
      "FromPort": 22,
      "ToPort": 22,
      "IpRanges": [
        {
          "CidrIp": "203.0.113.10/32",
          "Description": "SSH from my IP only"
        }
      ]
    },
    {
      "IpProtocol": "tcp",
      "FromPort": 80,
      "ToPort": 80,
      "IpRanges": [
        {
          "CidrIp": "0.0.0.0/0",
          "Description": "HTTP from anywhere"
        }
      ],
      "Ipv6Ranges": [
        {
          "CidrIpv6": "::/0",
          "Description": "HTTP from anywhere (IPv6)"
        }
      ]
    },
    {
      "IpProtocol": "tcp",
      "FromPort": 443,
      "ToPort": 443,
      "IpRanges": [
        {
          "CidrIp": "0.0.0.0/0",
          "Description": "HTTPS from anywhere"
        }
      ],
      "Ipv6Ranges": [
        {
          "CidrIpv6": "::/0",
          "Description": "HTTPS from anywhere (IPv6)"
        }
      ]
    }
  ],
  "IpPermissionsEgress": [
    {
      "IpProtocol": "-1",
      "IpRanges": [
        {
          "CidrIp": "0.0.0.0/0",
          "Description": "All outbound (AWS default) - updates and package installs"
        }
      ]
    }
  ]
}
